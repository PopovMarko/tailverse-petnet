# Copy to .env: cp .env.example .env
# KEY=VALUE format — read by both the Makefile and docker compose.

# HTTP server (use HTTP_ADDRESS=0.0.0.0 to reach the API from a phone on the same Wi-Fi)
HTTP_ADDRESS=127.0.0.1
HTTP_PORT=8080
HTTP_SHUTDOWN_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s

# PostgreSQL + PostGIS (docker compose service "postgres")
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres_user
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=postgres_db
POSTGRES_TIMEOUT=30s

# Redis (docker compose service "redis") — live presence at walk spots
REDIS_ADDRESS=localhost:6379
REDIS_PORT=6379
PRESENCE_TTL=2h

# JWT — local development only; use a long random secret anywhere else (openssl rand -hex 32)
AUTH_JWT_SECRET=local-dev-only-secret-change-me-0123456789
AUTH_ACCESS_TTL=15m
AUTH_REFRESH_TTL=720h

# Photo uploads (POST /api/v1/uploads, served at /uploads/{name}).
# UPLOADS_PUBLIC_BASE_URL is put in front of /uploads/{name} in returned URLs; leave it empty to use the
# scheme+host the client called (e.g. http://127.0.0.1:8080 from the iOS simulator, http://192.168.x.x:8080 from a phone).
UPLOADS_DIR=./data/uploads
UPLOADS_PUBLIC_BASE_URL=

# Logger (LOGGER_FOLDER is set by the Makefile to ./out/logs)
LOGGER_LEVEL=DEBUG
